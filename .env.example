# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Conexión MySQL (Base de datos relacional)
# El backend usa prepared statements en todas las consultas para prevenir inyección SQL.
MYSQL_HOST="localhost"
MYSQL_PORT="3306"
MYSQL_USER="jhonatan_db_user"
MYSQL_PASSWORD="TU_PASSWORD_SEGURO_MYSQL"
MYSQL_DATABASE="portafolio_jhonatan"

# Seguridad y Autenticación del Panel Administrativo
JWT_SECRET="clave_secreta_jwt_para_firmar_tokens_admin_2026"
ADMIN_DEFAULT_USER="admin"
ADMIN_DEFAULT_PASSWORD="AdminPassword2026*!"

# Notificaciones por Correo (Opcional - SMTP para avisos de nuevos mensajes)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="jhocamolu2010@gmail.com"
SMTP_PASS="tu_contrasena_de_aplicacion_smtp"
NOTIFICATION_EMAIL_TO="jhocamolu2010@gmail.com"
